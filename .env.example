# Esports Platform — environment variable catalog (names only; real values are set locally via 06-CREATE-LOCAL-ENV.cmd).
# Never commit real credentials. Development uses deterministic test doubles; production REFUSES them (see packages/core/src/config.ts).

# ---- runtime
NODE_ENV=development            # development | test | production
APP_ENV=local                   # local | ci | staging | production (staging/production enforce the production guards)
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
TRUST_PROXY=false               # true behind the Iranian edge/CDN or the nginx web container

# ---- database (MongoDB replica set; inside Compose: mongodb://mongo:27017/esports?replicaSet=rs0)
MONGO_URL=mongodb://127.0.0.1:27018/esports?directConnection=true
DATA_DIR=./data                 # private/public file buckets, quarantine and dev inbox (gitignored, backed up in prod)

# ---- secrets (REQUIRED in production, >= 32 chars; rotate via deployment, never via the coding agent)
APP_SECRET=
SESSION_TTL_HOURS=336
SIGNED_LINK_TTL_SECONDS=300

# ---- development identity double (ESP-02 replaces with mobile OTP). Must be false/empty in production.
AUTH_DEV_LOGIN_ENABLED=true
AUTH_DEV_CODE=change-me-dev-code

# ---- provider adapters: dev = deterministic test double (writes to DATA_DIR/dev-inbox), none = unconfigured (blocks with PROVIDER_NOT_CONFIGURED)
# Production adapters for the selected Iranian providers are added in later stages behind the same interfaces (INTG-001/002).
PAYMENT_ADAPTER=dev
SMS_ADAPTER=dev
EMAIL_ADAPTER=dev
STORAGE_ADAPTER=local           # local filesystem under DATA_DIR (valid in production on Iranian infrastructure with backups)
VIDEO_ADAPTER=dev
MAP_ADAPTER=dev
PUBLISHER_ADAPTER=none          # per-title exception only (13.2); never required by core flows
SCANNER_ADAPTER=dev             # dev | clamav | none
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---- limits
UPLOAD_MAX_BYTES_PRIVATE=26214400
UPLOAD_MAX_BYTES_PUBLIC=8388608
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---- outbox worker
OUTBOX_POLL_MS=500
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8
