# Coolify environment for compose.coolify.yaml.
# This is a LOW-TRAFFIC PUBLIC TEST profile. Never commit real values here.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Use the same HTTPS origin for both because nginx serves the SPA and proxies /api.
PUBLIC_WEB_ORIGIN=https://YOUR_DOMAIN
PUBLIC_API_ORIGIN=https://YOUR_DOMAIN

# Generate separately, for example: openssl rand -hex 32
APP_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Development login is intentionally enabled only for this test profile.
AUTH_DEV_LOGIN_ENABLED=true
AUTH_DEV_CODE=CHANGE_ME_PRIVATE_TEST_CODE

# Current repository provider implementations.
PAYMENT_ADAPTER=dev
SMS_ADAPTER=dev
# For real SMS: SMS_ADAPTER=kavenegar (set secrets only in the server environment).
KAVENEGAR_API_KEY=
# Exact approved Verify Lookup template name; its text must contain %token.
KAVENEGAR_OTP_TEMPLATE=
# Optional: used only for non-OTP transactional SMS, not Verify Lookup.
KAVENEGAR_SENDER=
EMAIL_ADAPTER=dev
STORAGE_ADAPTER=local
VIDEO_ADAPTER=dev
MAP_ADAPTER=dev
PUBLISHER_ADAPTER=none
SCANNER_ADAPTER=dev

SESSION_TTL_HOURS=336
SIGNED_LINK_TTL_SECONDS=300
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
OUTBOX_POLL_MS=500
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8

# Optional encrypted backups. Leave unset unless BACKUP_TARGET_DIR is an independent mounted failure domain.
# BACKUP_TARGET_DIR=
# BACKUP_ENCRYPTION_KEY=
# BACKUP_KEEP=24
# BACKUP_INTERVAL_MINUTES=10
