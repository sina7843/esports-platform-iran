{
  "name": "@esp/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QeSB design system — Vue 3 port of the DS components (source-only; Vite compiles the SFCs)",
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "index": "node scripts/gen-index.mjs"
  },
  "dependencies": {
    "@esp/contracts": "workspace:*"
  },
  "peerDependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vue-tsc": "3.3.13"
  }
}
